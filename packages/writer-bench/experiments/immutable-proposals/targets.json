{
  "systems": [
    {
      "id": "freeform-edit",
      "command": ["{node}", "--experimental-strip-types", "src/targets/proposal-experiment.ts"],
      "timeoutMs": 240000,
      "env": {
        "WRITER_BENCH_PROPOSAL_MODE": "freeform",
